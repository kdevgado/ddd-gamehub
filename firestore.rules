rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomCode} {
      function signedIn() {
        return request.auth != null;
      }

      function uid() {
        return request.auth.uid;
      }

      function isHost() {
        return signedIn() && resource.data.hostId == uid();
      }

      function isPlayer() {
        return signedIn() && uid() in resource.data.players;
      }

      function hasValidTimestamp() {
        return request.resource.data.updatedAt == request.time;
      }

      function isJoining() {
        return signedIn()
          && resource.data.phase == 'lobby'
          && !(uid() in resource.data.players)
          && uid() in request.resource.data.players
          && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([uid()])
          && request.resource.data.players[uid()].id == uid()
          && request.resource.data.players[uid()].name is string
          && request.resource.data.players[uid()].name.size() >= 1
          && request.resource.data.players[uid()].name.size() <= 24
          && request.resource.data.players[uid()].isHost == false
          && request.resource.data.players[uid()].joinedAt is int
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            resource.data.game == 'trivia'
              ? ['players', 'scores', 'updatedAt']
              : ['players', 'updatedAt']
          )
          && (resource.data.game != 'uno' || request.resource.data.players.size() <= 8)
          && (
            resource.data.game != 'trivia'
            || (
              request.resource.data.scores.diff(resource.data.scores).affectedKeys().hasOnly([uid()])
              && request.resource.data.scores[uid()] == 0
            )
          )
          && hasValidTimestamp();
      }

      function isLeaving() {
        return isPlayer()
          && !(uid() in request.resource.data.players)
          && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([uid()])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['players', 'scores', 'answers', 'uno', 'phase', 'updatedAt']
          )
          && hasValidTimestamp();
      }

      function isSubmittingTriviaAnswer() {
        return isPlayer()
          && resource.data.game == 'trivia'
          && resource.data.phase == 'question'
          && !(uid() in resource.data.answers)
          && uid() in request.resource.data.answers
          && request.resource.data.answers.diff(resource.data.answers).affectedKeys().hasOnly([uid()])
          && request.resource.data.answers[uid()] is string
          && request.resource.data.answers[uid()].size() <= 100
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'updatedAt'])
          && hasValidTimestamp();
      }

      function isPlayingUnoTurn() {
        return isPlayer()
          && resource.data.game == 'uno'
          && resource.data.phase == 'uno'
          && resource.data.uno.turnOrder[resource.data.uno.turnIndex] == uid()
          && request.resource.data.phase in ['uno', 'uno-finished']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uno', 'phase', 'updatedAt'])
          && hasValidTimestamp();
      }

      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.code == roomCode
        && request.resource.data.hostId == uid()
        && request.resource.data.game in ['trivia', 'uno']
        && request.resource.data.phase == 'lobby'
        && request.resource.data.players.size() == 1
        && uid() in request.resource.data.players
        && request.resource.data.players[uid()].id == uid()
        && request.resource.data.players[uid()].isHost == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (
        (
          isHost()
          && request.resource.data.code == resource.data.code
          && request.resource.data.game == resource.data.game
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.createdAt == resource.data.createdAt
          && hasValidTimestamp()
        )
        || isJoining()
        || isLeaving()
        || isSubmittingTriviaAnswer()
        || isPlayingUnoTurn()
      );

      allow delete: if isHost();
    }
  }
}
